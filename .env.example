# ============================================================
# .env.example — Copy this file to .env and fill in your key
# ============================================================
# NEVER commit your real .env file to GitHub.
# The .gitignore already excludes .env

# Your Google Gemini API key.
# Get one for free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the Gemini model name if Google updates it
# Default used by the app: gemini-1.5-flash-latest
GEMINI_MODEL=gemini-1.5-flash-latest
