# ============================================================
# .streamlit/secrets.toml.example
# ============================================================
# HOW TO USE:
#   1. Copy this file:  cp secrets.toml.example secrets.toml
#   2. Fill in your actual Gemini API key below.
#   3. secrets.toml is git-ignored so your key stays private.
#
# In app.py, the key is read with:  st.secrets["GEMINI_API_KEY"]
# ============================================================

GEMINI_API_KEY = "your_gemini_api_key_here"

# Optional — override the model name if Google deprecates the default
GEMINI_MODEL = "gemini-1.5-flash-latest"
